source "https://rubygems.org"

# Matches the exact Jekyll + plugin versions GitHub Pages uses.
gem "github-pages", group: :jekyll_plugins

# Needed for `jekyll serve` on Ruby 3+.
gem "webrick"

# Removed from Ruby 3.4's default gems but still required by Jekyll 3.x.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"

# Silences a github-metadata warning during builds.
gem "faraday-retry"
